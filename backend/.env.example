# =========================================================================
# GIOCHAT BACKEND - SUPABASE PRODUCTION CONFIGURATION
# =========================================================================

# 1. Supabase PostgreSQL Connection
# Option A: Supabase Connection Pooler (STRONGLY RECOMMENDED for Render, Railway, Fly.io - IPv4 compatible)
# In Supabase Dashboard: Project Settings -> Database -> Connection String -> Session Mode
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.[YOUR-PROJECT-REF]
SPRING_DATASOURCE_PASSWORD=Finish@23

# Option B: Direct Connection (Requires IPv6 network support)
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_supabase_database_password

# 2. JWT Secret (Generate a strong random secret key for production)
JWT_SECRET=your_super_strong_jwt_secret_key_minimum_32_characters_long

# 3. Server Port (Render/Railway injects PORT automatically)
PORT=10000
