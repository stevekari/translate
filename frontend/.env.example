# WebRTC relay configuration for users on different networks/countries.
# Use TURN URLs from your managed provider or public coturn server.
# Comma-separated values are supported, for example:
# turn:turn.example.com:3478,turns:turn.example.com:5349
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
